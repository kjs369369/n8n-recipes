            "긴급도": "={{ $json.urgency }}",
            "발신자": "={{ $json.original.from }}",
            "요약": "={{ $json.summary }}"
          }
        },
        "options": {}
      },
      "id": "c436ea1e-82dd-46cd-a770-a16108bbe8d9",
